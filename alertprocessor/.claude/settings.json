{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go list:*)",
      "Bash(go doc:*)",
      "Bash(gofmt:*)",
      "Bash(make test)",
      "Bash(make test-integration)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make build)",
      "Bash(make check)",
      "Bash(make am-config)",
      "Bash(make logs)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl api-resources:*)",
      "Bash(kubectl auth can-i:*)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config get-contexts:*)",
      "Bash(docker build:*)",
      "Bash(docker image inspect:*)",
      "Bash(docker ps:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/alertprocessor/.claude/hooks/format_go.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/alertprocessor/.claude/hooks/guard_kubectl.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/alertprocessor/.claude/hooks/unit_tests.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
